NODE_ENV=development
PORT=8000

# Pooled connection — used by the app (PrismaClient)
DATABASE_URL=postgresql://user:password@localhost:5432/sunrintoday?sslmode=require&uselibpqcompat=true

# Direct (non-pooled) connection — used by Prisma Migrate / Studio / Introspect
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/sunrintoday?sslmode=require&uselibpqcompat=true

# Redis — meal response cache (prefer maxmemory-policy allkeys-lru)
REDIS_URL=redis://127.0.0.1:6379

KEY=your-secret-key
SWAGGER_ENDPOINT=/docs
